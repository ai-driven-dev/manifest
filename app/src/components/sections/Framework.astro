---
import { FRAMEWORK } from '~/content/framework';
---
<section id="framework" class="framework" aria-labelledby="framework-title">
  <div class="chapter-open">
    <div class="chapter-body">
      <p class="chapter-eyebrow">From principles to practice</p>
      <h2 id="framework-title">{FRAMEWORK.title}</h2>
      <div class="chapter-lede"><p>{FRAMEWORK.description}</p></div>
    </div>
  </div>
  <p class="framework-compatibility">{FRAMEWORK.compatibility}</p>
  <ol class="framework-steps">
    {FRAMEWORK.steps.map((step) => (
      <li>
        <h3>{step.title}</h3>
        <p>{step.description}</p>
        {step.command && <pre><code>{step.command}</code></pre>}
        <a href={step.link.url} target="_blank" rel="noopener noreferrer">{step.link.label} <span aria-hidden="true">↗</span></a>
      </li>
    ))}
  </ol>
  <p class="framework-safety">{FRAMEWORK.safety}</p>
</section>
