---
import Page from '~/components/layout/Page.astro';
import { SITE, absoluteUrl } from '~/lib/site';

const description =
  'Privacy policy for the AI-Driven Development manifesto site, including signatory data and third-party requests.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Privacy',
    url: absoluteUrl('/privacy'),
    description,
    inLanguage: SITE.lang,
    isPartOf: { '@id': `${absoluteUrl('/')}#website` },
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SITE.shortName, item: absoluteUrl('/') },
        { '@type': 'ListItem', position: 2, name: 'Privacy', item: absoluteUrl('/privacy') },
      ],
    },
  },
];
---
<Page title="Privacy" description={description} path="/privacy" jsonLd={jsonLd}>
  <main class="plain-page" id="main">
    <div class="plain-page-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Privacy</span>
      </nav>

      <h1>Privacy</h1>
      <p>
        This site publishes the AI-Driven Development manifesto. It does not run
        advertising or set analytics cookies.
      </p>

      <h2>Audience measurement</h2>
      <p>
        We use our self-hosted Umami service at <code>stats.ai-driven-dev.fr</code> to
        measure visits to the manifesto and this privacy page, and departures to the
        GitHub signature form. A departure does not mean a signature has been published.
        The tracker sends the page path, title, browser language, screen dimensions,
        and referring site's origin. URL queries and fragments, referrer paths,
        names, and GitHub handles are not sent. We do not use session replay or assign
        personal visitor identifiers.
      </p>

      <h2>Signatories</h2>
      <p>
        Public signatories are stored as YAML files in the GitHub repository. If you sign,
        the name, GitHub handle, optional LinkedIn URL, optional affiliation, signature date,
        and optional statement you submit become public through the repository and this site.
      </p>

      <h2>Third-party requests</h2>
      <p>
        The signatory wall loads GitHub avatar images from GitHub-controlled domains. The
        sign and repository links navigate to GitHub when activated. Our Umami script
        loads from the audience measurement service described above.
      </p>

      <h2>Browser signals</h2>
      <p>
        Global Privacy Control and Do Not Track disable audience measurement: the tracker
        does not load when either signal is enabled. This site does not sell personal data.
      </p>

      <h2>Contact</h2>
      <p>
        Privacy and correction requests can be opened as repository issues or pull requests.
        Security reports should use the published <code>/.well-known/security.txt</code>.
      </p>
    </div>
  </main>
</Page>
