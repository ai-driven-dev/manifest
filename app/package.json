{
  "name": "manifest-astro",
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "gen:signature-dates": "node scripts/gen-signature-dates.mjs",
    "predev": "node scripts/gen-signature-dates.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/gen-signature-dates.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "serve": "node ./dist/server/entry.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:checklist": "playwright test tests/e2e/checklist.spec.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/node": "10.1.4",
    "astro": "6.4.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false,
    "sharp": true
  }
}
